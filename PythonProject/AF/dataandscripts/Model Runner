{"cells":[{"cell_type":"code","source":["import torch\n","import torch.nn as nn\n","import pandas as pd\n","import json\n","import os\n","\n","# 1. Define the model architecture based on the metadata in pytorch_model.pt\n","class SimpleNN(nn.Module):\n","    def __init__(self, input_dim=2):\n","        super(SimpleNN, self).__init__()\n","        self.layer1 = nn.Linear(input_dim, 16)\n","        self.layer2 = nn.Linear(16, 8)\n","        self.output_layer = nn.Linear(8, 1)\n","        self.sigmoid = nn.Sigmoid()\n","\n","    def forward(self, x):\n","        x = torch.relu(self.layer1(x))\n","        x = torch.relu(self.layer2(x))\n","        x = self.sigmoid(self.output_layer(x))\n","        return x\n","\n","def load_manifest():\n","    \"\"\"Helper to parse the JSONL manifest for multi-modal correlation.\"\"\"\n","    manifest_map = {}\n","    if os.path.exists('manifest.jsonl'):\n","        try:\n","            with open('manifest.jsonl', 'r') as f:\n","                for line in f:\n","                    entry = json.loads(line)\n","                    # Use cycle and script_name as a composite key if available\n","                    key = f\"{entry.get('script_name')}_{entry.get('cycle')}\"\n","                    manifest_map[key] = entry\n","            print(f\"Manifest loaded: {len(manifest_map)} asset references indexed.\")\n","        except Exception as e:\n","            print(f\"Warning: Could not parse manifest.jsonl: {e}\")\n","    return manifest_map\n","\n","def run_inference():\n","    print(\"Initializing Neuralink Model Runner with Manifest Correlation...\")\n","\n","    # 2. Load the model weights\n","    model = SimpleNN()\n","    try:\n","        state_dict = torch.load('pytorch_model.pt', map_location=torch.device('cpu'))\n","        model.load_state_dict(state_dict)\n","        model.eval()\n","        print(\"Model weights loaded successfully.\")\n","    except Exception as e:\n","        print(f\"Error loading model: {e}\")\n","        return\n","\n","    # 3. Load the telemetry and manifest\n","    try:\n","        df = pd.read_csv('autocad_data.csv')\n","        manifest_data = load_manifest()\n","\n","        features = df[['Geometric Precision', 'Assembly Efficiency']].values\n","        feature_tensor = torch.tensor(features, dtype=torch.float32)\n","        print(f\"Loaded {len(df)} rows of telemetry data.\")\n","    except Exception as e:\n","        print(f\"Error initializing data: {e}\")\n","        return\n","\n","    # 4. Run Inference & Correlate Assets\n","    results = []\n","    with torch.no_grad():\n","        predictions = model(feature_tensor)\n","\n","        for i, pred in enumerate(predictions):\n","            row = df.iloc[i]\n","            cycle_val = int(row['Cycle'])\n","            confidence = round(pred.item(), 4)\n","            prediction_val = 1 if confidence > 0.5 else 0\n","\n","            # Attempt to find the synthetic asset in the manifest\n","            # Note: We default to the 'model' script as the primary driver for these results\n","            asset_key = f\"model_{cycle_val}\"\n","            asset = manifest_data.get(asset_key, {})\n","\n","            results.append({\n","                \"cycle\": cycle_val,\n","                \"confidence\": confidence,\n","                \"prediction\": prediction_val,\n","                \"actual\": int(row['Precision Change']),\n","                \"metadata\": {\n","                    \"mood\": asset.get(\"text\", \"N/A\"),\n","                    \"image\": asset.get(\"image_path\"),\n","                    \"audio\": asset.get(\"audio_path\"),\n","                    \"video\": asset.get(\"video_path\")\n","                }\n","            })\n","\n","    # 5. Export Results\n","    output_file = 'inference_results.json'\n","    with open(output_file, 'w') as f:\n","        json.dump(results, f, indent=2)\n","\n","    # Summary Analysis\n","    correct = sum(1 for r in results if r['prediction'] == r['actual'])\n","    accuracy = (correct / len(results)) * 100\n","    print(f\"\\nInference complete. Results saved to {output_file}\")\n","    print(f\"Validation Accuracy: {accuracy:.2f}%\")\n","\n","    # Identify a high-confidence anomaly\n","    anomalies = [r for r in results if r['prediction'] != r['actual'] and r['confidence'] > 0.8]\n","    if anomalies:\n","        print(f\"Detected {len(anomalies)} high-confidence deviations for manual review.\")\n","\n","if __name__ == \"__main__\":\n","    run_inference()"],"outputs":[{"output_type":"stream","name":"stdout","text":["Initializing Neuralink Model Runner with Manifest Correlation...\n","Error loading model: Error(s) in loading state_dict for SimpleNN:\n","\tsize mismatch for layer1.weight: copying a param with shape torch.Size([32, 2]) from checkpoint, the shape in current model is torch.Size([16, 2]).\n","\tsize mismatch for layer1.bias: copying a param with shape torch.Size([32]) from checkpoint, the shape in current model is torch.Size([16]).\n","\tsize mismatch for layer2.weight: copying a param with shape torch.Size([16, 32]) from checkpoint, the shape in current model is torch.Size([8, 16]).\n","\tsize mismatch for layer2.bias: copying a param with shape torch.Size([16]) from checkpoint, the shape in current model is torch.Size([8]).\n","\tsize mismatch for output_layer.weight: copying a param with shape torch.Size([2, 16]) from checkpoint, the shape in current model is torch.Size([1, 8]).\n","\tsize mismatch for output_layer.bias: copying a param with shape torch.Size([2]) from checkpoint, the shape in current model is torch.Size([1]).\n"]}],"execution_count":6,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oSDIhSsYJLJ9","executionInfo":{"status":"ok","timestamp":1768723887360,"user_tz":300,"elapsed":19,"user":{"displayName":"waleed ahmed","userId":"04661694643362022124"}},"outputId":"e20b4cc5-258d-4937-e9dc-bc0f028d851c"}},{"cell_type":"markdown","metadata":{"id":"b6ad6863"},"sou